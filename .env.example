# === Infrastructure ===
# Timeweb Cloud API token (required for Terraform and TWC CLI)
TF_VAR_timeweb_token=your-timeweb-token-here
TWC_TOKEN=your-timeweb-token-here

# Optional S3 credentials for a remote Terraform backend
AWS_ACCESS_KEY_ID=your-s3-access-key
AWS_SECRET_ACCESS_KEY=your-s3-secret-key

# === Kubernetes Cluster ===
TF_VAR_cluster_name=gitops-cluster
TF_VAR_node_count=1
# TF_VAR_project_id=1115913
# TF_VAR_network_id=network-xxx
# TF_VAR_location=ru-1
# TF_VAR_master_cpu=2
# TF_VAR_worker_cpu=2
# TF_VAR_k8s_version=v1.34.2+k0s.0
# TF_VAR_network_driver=flannel
# TF_VAR_autoscaling=false
# TF_VAR_max_runtime_minutes=120
# TF_VAR_max_cost_rub=80

# === Application Secrets ===
# OpenRouter API
OPENROUTER_API_KEY=sk-or-xxx

# GitHub PAT for Argo Image Updater
GITHUB_PAT=github_pat_xxx
GITHUB_USERNAME=justgithubaccount
GITHUB_REPO_URL=https://github.com/justgithubaccount/app-poly-gitops-helm

# PostgreSQL (when ready)
# DATABASE_URL=postgresql://user:pass@host:5432/db
